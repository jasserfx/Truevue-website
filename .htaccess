# ============================================================
#  TrueVue Studio — Apache Configuration
# ============================================================

RewriteEngine On

# ------------------------------------------------------------
# 1. FORCE HTTPS
# ------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# 2. SECURITY
# ------------------------------------------------------------
Options -Indexes
ServerSignature Off

# Block access to sensitive files
<FilesMatch "\.(env|json|md|log|gitignore)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------
# 3. COMING SOON MODE  ← comment this whole block when ready
# ------------------------------------------------------------
#RewriteCond %{REQUEST_URI} !^/Coming-Soon\.html$ [NC]
#RewriteCond %{REQUEST_URI} !^/css/ [NC]
#RewriteCond %{REQUEST_URI} !^/js/ [NC]
#RewriteCond %{REQUEST_URI} !^/images/ [NC]
#RewriteCond %{REQUEST_URI} !^/fonts/ [NC]
#RewriteRule ^.*$ /Coming-Soon.html [R=302,L]

# ------------------------------------------------------------
# 4. LIVE MODE  ← uncomment this whole block when going live
# ------------------------------------------------------------
 DirectoryIndex Home.html

 # Clean URLs (optional): /about → /About.html
 RewriteCond %{REQUEST_FILENAME} !-f
 RewriteCond %{REQUEST_FILENAME} !-d
 RewriteCond %{REQUEST_FILENAME}.html -f
 RewriteRule ^([^/]+)/?$ /$1.html [L]

 # 404 fallback
 ErrorDocument 404 /Home.html

# ------------------------------------------------------------
# 5. PERFORMANCE (active in both modes)
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
