# ─── Server ────────────────────────────────────────────
PORT=3001

# ─── Frontend URL (set to your deployed frontend domain) ─
FRONTEND_URL=https://your-site.com

# ─── JWT Secret (change this to a long random string!) ──
JWT_SECRET=change-this-to-a-long-random-secret-string

# ─── Admin password (first-time setup) ─────────────────
# After first launch, change password via the admin panel
ADMIN_PASSWORD=admin123

# ─── Email (Gmail recommended) ─────────────────────────
# For Gmail: enable 2FA then create an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# ─── Where to receive contact form notifications ────────
NOTIFY_EMAIL=Contact@truevuestudio.com
